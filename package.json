{
  "name": "story-timeline",
  "version": "1.8.1",
  "private": true,
  "description": "序时 · 小说与游戏作品时间轴",
  "author": "Symplatt",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run tests/model.test.ts && node --test tests/store.test.cjs",
    "desktop": "npm run build && electron .",
    "pack:release": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "lucide-vue-next": "^0.577.0",
    "vue": "3.5.30"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "electron": "44.4.1",
    "electron-builder": "^26.8.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.symplatt.xushi",
    "productName": "序时",
    "copyright": "Copyright © 2026 Symplatt. All rights reserved.",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "序时",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "artifactName": "Xushi-Setup-${version}.exe"
    }
  }
}
